RESUME_DIR_HOST=/path/to/your/resumes

FASTMCP_PORT=8001
LOG_LEVEL=INFO

# Allowed CORS origins for HTTP transport mode.
# Use * to allow all origins (local dev / internal tools only).
# For production, use a comma-separated list: http://localhost:3000,https://myapp.com
FASTMCP_CORS_ORIGINS=*

# Optional: override the filename regex used to classify documents into
# doc_type buckets (resume, cover_letter, application_material). Unset
# variables keep the built-in default pattern for that category. Matching
# is case-insensitive and patterns may use any Python regex syntax, e.g.
# alternation (|), optional characters (?), and escaped literal dots (\.).
# See _DEFAULT_PATTERNS in resume_mcp_server/collection.py for the defaults.
# DOC_TYPE_PATTERN_RESUME=resume|cv
# DOC_TYPE_PATTERN_COVER_LETTER=cover.?letter|_cl\.|coverletter
# DOC_TYPE_PATTERN_APPLICATION_MATERIAL=interview|why_|job.?desc
