RESUME_DIR_HOST=/path/to/your/resumes

FASTMCP_PORT=8001
LOG_LEVEL=INFO

# Allowed CORS origins for HTTP transport mode.
# Use * to allow all origins (local dev / internal tools only).
# For production, use a comma-separated list: http://localhost:3000,https://myapp.com
FASTMCP_CORS_ORIGINS=*

# Optional: override the filename regex used to classify documents into
# doc_type buckets (resume, cover_letter, application_material). Unset
# variables keep the built-in default pattern for that category.
# DOC_TYPE_PATTERN_RESUME=lebenslauf
# DOC_TYPE_PATTERN_COVER_LETTER=anschreiben
# DOC_TYPE_PATTERN_APPLICATION_MATERIAL=vorstellungsgespraech
